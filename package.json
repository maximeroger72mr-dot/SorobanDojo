{
  "name": "soroban-apprendre",
  "version": "0.26.1",
  "description": "Apprendre le soroban (boulier japonais)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "dist:win": "electron-builder --win portable",
    "html": "node scripts/construire-html.mjs",
    "polices": "node scripts/polices.mjs",
    "verifier": "node scripts/verifier-ecrans.cjs",
    "banc": "node scripts/banc-planches.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "subset-font": "^2.9.0"
  },
  "productName": "Soroban",
  "type": "module",
  "build": {
    "appId": "fr.soroban.apprendre",
    "productName": "Soroban",
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Soroban-${version}-Windows.exe"
    },
    "compression": "maximum",
    "electronLanguages": [
      "fr",
      "en-US"
    ]
  }
}
