{
  "name": "soroban-apprendre",
  "version": "0.1.0",
  "description": "Apprendre le soroban (boulier japonais)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "Soroban",
  "type": "module",
  "build": {
    "appId": "fr.soroban.apprendre",
    "productName": "Soroban",
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    }
  }
}
